---
import { getCollection } from 'astro:content';
import BlogCard from './blogCard.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

{posts.length > 0 && (
	<section id="blog" class="px-4 py-16 lg:p-16">
		<div class="mb-10 text-center">
			<p class="mb-2 text-sm font-medium tracking-wide text-[#5476CC] uppercase dark:text-[#FFC517]">BLOG</p>
			<h1 class="text-4xl font-bold text-[#333333] dark:text-white">
				Latest <span class="text-[#5476CC] dark:text-[#FFC517]">Articles</span>
			</h1>
		</div>
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => <BlogCard post={post} />)}
		</div>
		<div class="mt-10 text-center">
			<a href="/blog" class="inline-flex rounded-lg bg-[#5476CC] px-6 py-3 font-semibold text-white transition-colors hover:bg-[#4565b8] dark:bg-[#FFC517] dark:text-[#151515] dark:hover:bg-[#e6b115]">
				See All Articles
			</a>
		</div>
	</section>
)}
