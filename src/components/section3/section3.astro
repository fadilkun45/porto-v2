---
import CardCertifications from './cardCertification';
---

<section id="certification" class="px-4 py-16 lg:p-16">
	<div class="mb-10 text-center">
		<p class="mb-2 text-sm font-medium tracking-wide text-[#5476CC] uppercase dark:text-[#FFC517]">CERTIFICATION</p>
		<h1 class="text-4xl font-bold text-[#333333] dark:text-white">
			Proof of My <span class="text-[#5476CC] dark:text-[#FFC517]">Learning Journey</span>
		</h1>
	</div>
	<CardCertifications client:load />
</section>
